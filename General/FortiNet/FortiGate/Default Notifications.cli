config system automation-action
    edit "Default Email"
        set description "Default automation action configuration for sending an email with basic information on the log event."
        set action-type email
        set email-to "support@conekt.co.za"
        set email-subject "%%log.logdesc%%"
    next
end
config system automation-stitch
    edit "Network Down"
        set description "Default automation stitch to send an email when a network goes down."
        set status enable
        set trigger "Network Down"
        set condition-logic and
        config actions
            edit 1
                set action "Default Email"
                set delay 0
                set required enable
            next
        end
    next
    edit "HA Failover"
        set description "Default automation stitch to send an email when a HA failover is detected."
        set status enable
        set trigger "HA Failover"
        set condition-logic and
        config actions
            edit 1
                set action "Default Email"
                set delay 0
                set required enable
            next
        end
    next
    edit "Conserve Mode"
        set trigger "Conserve Mode"
        config actions
            edit 1
                set action "Default Email"
                set required enable
            next
        end
    next
    edit "Local Certificate Expiry"
        set trigger "Local Certificate Expiry"
        config actions
            edit 1
                set action "Default Email"
                set required enable
            next
        end
    next
    edit "High CPU"
        set trigger "High CPU"
        config actions
            edit 1
                set action "Default Email"
                set required enable
            next
        end
    next
end


# Add only for Systems which run an SD-WAN Configuration

config system automation-trigger
    edit "SDWAN Warning"
        set description ''
        set trigger-type event-based
        set event-type event-log
        set logid 22931 22930
    next
end
config system automation-stitch
    edit "SDWAN Warning"
        set description "Automation stitch to send an email when an SDWAN interface reports a warning."
        set status enable
        set trigger "SDWAN Warning"
        set condition-logic and
        config actions
            edit 1
                set action "Default Email"
                set delay 0
                set required enable
            next
        end
end
